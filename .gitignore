# Build (generated in CI at release time, see .github/workflows/release.yml)
/build/
/dist/
everest-forms.zip
/languages/everest-forms.pot
assets/js/admin/*.min.js
assets/js/frontend/*.min.js
*.css.map

# Compiled CSS (Gruntfile.js sass/rtlcss tasks, assets/css/ top level only —
# nested vendor dirs and addons/ have no build step here, stay tracked).
# select2-rtl.css/flatpickr-rtl.css are explicitly excluded from rtlcss's
# own glob and have no regeneration path, so they stay tracked too.
/assets/css/*.css
!/assets/css/select2-rtl.css
!/assets/css/flatpickr-rtl.css

# Minified vendor JS explicitly regenerated by the uglify:vendor Grunt
# target (see Gruntfile.js) — everything else under assets/js/* ships
# pre-minified with no build step here and stays tracked.
/assets/js/inputmask/jquery.inputmask.bundle.min.js
/assets/js/jquery-blockui/jquery.blockUI.min.js
/assets/js/jquery-confirm/jquery-confirm.min.js
/assets/js/jquery-validate/jquery.validate.min.js
/assets/js/flatpickr/flatpickr.min.js
/assets/js/mailcheck/mailcheck.min.js
/assets/js/perfect-scrollbar/perfect-scrollbar.min.js
/assets/js/selectWoo/selectWoo.min.js
/assets/js/tooltipster/tooltipster.bundle.min.js

# Vendored, no non-min source — was incorrectly caught by the blanket
# assets/js/admin/*.min.js rule above and silently untracked; restore it.
!/assets/js/admin/printThis.min.js

# Unit tests
/tests/.env
/tests/wordpress

